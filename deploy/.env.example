# Copy to deploy/.env with scripts/generate-deploy-env.ps1.
# Values must remain URL-safe because database passwords are embedded in DSNs.

NEW_API_IMAGE_TAG=v1.0.0-rc.21-yc.1
NEW_API_HOST_PORT=3101
NEW_API_PUBLIC_URL=https://api.yanchuaner.cn
NEW_API_SESSION_COOKIE_SECURE=true
NEW_API_SESSION_COOKIE_TRUSTED_URL=https://api.yanchuaner.cn
AI_CORE_NETWORK=yanchuaner-ai-core
REDIS_HOST_PORT=6380

CONTROL_DB_PASSWORD=replace-with-url-safe-random-secret
GATEWAY_DB_PASSWORD=replace-with-url-safe-random-secret
REDIS_PASSWORD=replace-with-url-safe-random-secret

NEW_API_SESSION_SECRET=replace-with-at-least-32-random-bytes
NEW_API_CRYPTO_SECRET=replace-with-at-least-32-random-bytes

NEW_API_ROOT_USERNAME=yanchuaner
NEW_API_ROOT_PASSWORD=replace-with-url-safe-random-secret

# New API 额度单位默认每 500000 = 1 USD；内测值分别约为 2 USD/新校友、20 USD/AI 工作台共享预算。
# 正式上线前必须按公益资金预算重新确认，不要在脚本中设置无限额度。
NEW_USER_INITIAL_QUOTA=1000000
OPENWEBUI_SERVICE_QUOTA=10000000

YANCHUANER_OAUTH_CLIENT_ID=api-yanchuaner
YANCHUANER_OAUTH_CLIENT_SECRET=replace-with-at-least-32-random-bytes
YANCHUANER_AI_OAUTH_CLIENT_ID=ai-yanchuaner
YANCHUANER_AI_OAUTH_CLIENT_SECRET=replace-with-a-different-random-secret
WEB_MAIN_PUBLIC_URL=https://yanchuaner.cn
WEB_MAIN_INTERNAL_URL=https://yanchuaner.cn

LITELLM_PUBLIC_URL=http://127.0.0.1:4000
LITELLM_INTERNAL_URL=http://litellm-gateway:4000

LITELLM_MASTER_KEY=sk-replace-with-random-secret
LITELLM_SALT_KEY=sk-replace-with-stable-random-secret
LITELLM_UI_USERNAME=yanchuaner
LITELLM_UI_PASSWORD=replace-with-random-secret

# Created later as a dedicated LiteLLM virtual key for the New API channel.
# Do not use LITELLM_MASTER_KEY as the long-term channel key.
LITELLM_NEW_API_KEY=
